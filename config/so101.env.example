# Copy to .env.so101.local at the repository root and fill in your own values.
HOST=127.0.0.1
PORT=8080
LENSMIND_DEVICE_BACKEND=so101
LENSMIND_CALIBRATION_REQUIRED=true
LENSMIND_CALIBRATION_PORT=
LENSMIND_CALIBRATION_FILE=config/so101-calibration.local.json
LENSMIND_CALIBRATION_PYTHON=python
# Optional SHA-256 of a previously verified calibration that matches the sample.
LENSMIND_CALIBRATION_RESUME_SHA256=
LENSMIND_WRIST_CAMERA_LABEL=
LENSMIND_SO101_BRIDGE_PORT=8767
# Use the same locally generated token in the bridge environment.
LENSMIND_SO101_TOKEN=
